<?xml version="1.0" encoding="utf-8"?>
<manifest
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <application
    android:enableOnBackInvokedCallback="true"
    android:icon="@mipmap/ic_launcher"
    android:name=".HakusanApplication"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher"
    android:theme="@style/Theme.Hakusan">
    <activity
      android:name=".HakusanActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Keep the application-owned database in the main process. -->
    <service
      android:name="androidx.room3.MultiInstanceInvalidationService"
      tools:ignore="MissingClass"
      tools:node="remove" />
  </application>
</manifest>
